# Auto detect text files and perform LF normalization
* text=auto eol=lf
*.php text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf

# Exclude repository and development files from the WordPress release archive.
/.gitattributes export-ignore
/.github export-ignore
/.gitignore export-ignore
/.local export-ignore
/package-lock.json export-ignore
/package.json export-ignore
/playwright.config.js export-ignore
/tests export-ignore
