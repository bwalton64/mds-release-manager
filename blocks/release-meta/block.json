{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mds-rm/release-meta",
	"title": "Release Meta Block",
	"category": "mds-release-manager",
	"icon": "album",
	"textdomain": "mds-release-manager",
	"usesContext": ["postId", "postType"],
	"attributes": {
		"upcOverride": { "type": "string", "default": "" },
		"releaseId": { "type": "integer", "default": 0 },
		"metaStyles": { "type": "object" },
		"items": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"field": { "type": "string" },
					"enabled": { "type": "boolean" },
					"icon": { "type": "string" },
					"title": { "type": "string" }
				}
			}
		},
		"styles": { "type": "object", "default": {}, "additionalProperties": true }
	},
	"editorScript": "mds-rm-release-meta-editor",
	"editorStyle": "mds-rm-release-meta-editor-style"
}
