# LocalWP Playwright E2E Environment (copy to `.env.e2e`, which is gitignored)
#
# Requirements (enforced by tests/e2e/global-setup.js):
# 1. Create a separate, disposable 1-site Multisite in LocalWP (e.g. `mds-e2e.local`).
# 2. Copy or symlink `mds-release-manager` into that site's `wp-content/plugins/` and Network Activate it.
# 3. Run once: `npx.cmd playwright install chromium`
# 4. Run tests: `npm.cmd run test:e2e`

MDS_RM_PHP=C:\Users\Brian\AppData\Roaming\Local\lightning-services\php-8.2.29+0\bin\win64\php.exe
MDS_RM_PHP_INI=C:\Users\Brian\AppData\Roaming\Local\run\<YOUR-SITE-ID>\conf\php\php.ini
MDS_RM_WP_CLI=C:\Program Files (x86)\Local\resources\extraResources\bin\wp-cli\wp-cli.phar
MDS_RM_TEST_URL=http://mds-e2e.local
MDS_RM_WP_PATH=C:\Users\Brian\Local Sites\mds-e2e\app\public
MDS_RM_TEST_ALLOW_MUTATIONS=1
